NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blood_platform
JWT_ACCESS_SECRET=replace-with-long-random-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
RESET_TOKEN_TTL_MINUTES=30
AUTH_VERIFICATION_CODE_EXPIRY_MINUTES=5
AUTH_VERIFICATION_RESEND_COOLDOWN_SECONDS=45
AUTH_VERIFICATION_MAX_RESENDS_PER_HOUR=5
AUTH_VERIFICATION_MAX_ATTEMPTS_PER_CODE=5
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=Blood Response Platform <your-gmail@gmail.com>
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:3000

# SMS is optional for local development. Keep disabled unless provider credentials are available.
SMS_ENABLED=false
SMS_PROVIDER=console
SMS_FROM=BloodResponse
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_API_KEY=


BMS_SMS_ENABLED=false
BMS_API_KEY=
BMS_BASE_URL=https://api.mnotify.com/api
BMS_SENDER_ID=BloodSOS
BMS_SMS_TIMEOUT_MS=15000
BMS_SMS_MAX_RECIPIENTS=100
BMS_SMS_RETRY_ATTEMPTS=2
DONOR_CONTACT_EXPORT_MAX_ROWS=5000
SMS_CAMPAIGN_MAX_RECIPIENTS=1000
SMS_CAMPAIGN_BATCH_SIZE=100
SMS_CAMPAIGN_MESSAGE_MAX_LENGTH=480

# Daily donor re-engagement SMS for donors whose completed donation is six calendar months old.
# Keep disabled until provider credentials, consent rules, and audit checks are verified.
DONOR_SIX_MONTH_REMINDER_ENABLED=false
DONOR_SIX_MONTH_REMINDER_CRON=0 8 * * *
DONOR_SIX_MONTH_REMINDER_TIMEZONE=Africa/Accra
DONOR_SIX_MONTH_REMINDER_MONTHS=6

AI_INTELLIGENCE_ENABLED=true
AI_DEMAND_LOOKBACK_DAYS=30
AI_EXPIRY_WARNING_DAYS=7
AI_DEFAULT_RADIUS_KM=20
AI_DEFAULT_DONOR_LIMIT=25
AI_HIGH_RISK_SCORE=70
AI_CRITICAL_RISK_SCORE=85
AI_MIN_DONOR_RECOMMENDATION_SCORE=50

ASSISTANT_ENABLED=true
ASSISTANT_PUBLIC_ENABLED=true
ASSISTANT_CONTEXT_TTL_MINUTES=30
ASSISTANT_MAX_MESSAGE_LENGTH=500
ASSISTANT_PUBLIC_RATE_LIMIT=20
ASSISTANT_AUTH_RATE_LIMIT=60
