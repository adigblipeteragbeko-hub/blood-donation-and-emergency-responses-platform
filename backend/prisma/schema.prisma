generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  HOSPITAL_ADMIN
  DONOR
  HOSPITAL_STAFF
  INVENTORY_OFFICER
  DONOR_REVIEW_OFFICER
  WEBSITE_CONTENT_ADMIN
  AUDITOR
}

enum PermissionCode {
  PLATFORM_ANALYTICS_VIEW
  PLATFORM_SECURITY_VIEW
  RBAC_MANAGE
  HOSPITAL_APPROVE
  ACCOUNT_SUSPEND
  EMERGENCY_OVERRIDE
  NATIONAL_ALERT_BROADCAST
  WEBSITE_CONTENT_MANAGE
  AUDIT_LOG_VIEW
  AUDIT_LOG_EXPORT
  HOSPITAL_OPERATIONS_VIEW
  HOSPITAL_STAFF_MANAGE
  HOSPITAL_SETTINGS_MANAGE
  INVENTORY_MANAGE
  INVENTORY_REPORT_VIEW
  DONOR_REVIEW_MANAGE
  DONOR_REVIEW_APPROVE
  BLOOD_REQUEST_CREATE
  BLOOD_REQUEST_APPROVE
  BLOOD_REQUEST_PROGRESS_UPDATE
  DONOR_MATCH_VIEW
  APPOINTMENT_MANAGE
  REPORT_VIEW
  SECURITY_MONITOR_VIEW
  GLOBAL_SEARCH_USE
}

enum DepartmentType {
  ADMINISTRATION
  EMERGENCY
  LABORATORY
  BLOOD_BANK
  DONOR_SERVICES
  COMPLIANCE
  OPERATIONS
}

enum StaffAccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum BloodGroup {
  O_POS
  O_NEG
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
}

enum RequestType {
  STANDARD
  EMERGENCY
}

enum RequestStatus {
  OPEN
  MATCHING
  FULFILLED
  CANCELLED
}

enum PriorityLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  MISSED
  NO_SHOW
}

enum RequestProgressStatus {
  PENDING
  MATCHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InventoryChangeType {
  ADDED
  USED
  EXPIRED
  ADJUSTED
}

enum DonorResponseStatus {
  PENDING
  ACCEPTED
  DECLINED
  DONATED
}

enum NotificationType {
  EMERGENCY_REQUEST
  REMINDER
  APPOINTMENT
  INVENTORY_ALERT
  SYSTEM
}

enum WebsiteStatisticKey {
  REGISTERED_DONORS
  EMERGENCY_MATCHES
  PARTNER_HOSPITALS
  REQUESTS_COMPLETED
}

enum WebsiteAnnouncementType {
  ALERT
  AWARENESS
  SYSTEM
}

enum DonorReviewStatus {
  SUBMITTED
  HOSPITAL_REVIEW
  OFFICE_USE_COMPLETED
  APPROVED
  REJECTED
}

enum DonorClinicalStatus {
  DRAFT
  SUBMITTED
  HOSPITAL_REVIEW
  OFFICE_USE_COMPLETED
  APPROVED
  REJECTED
  TEMPORARILY_DEFERRED
  PERMANENTLY_DEFERRED
}

enum ClinicalPassFail {
  PASSED
  FAILED
}

enum ClinicalYesNo {
  YES
  NO
}

enum ClinicalScreeningOutcome {
  QUALIFIED
  TEMPORARILY_DEFERRED
  PERMANENTLY_DEFERRED
  REJECTED
}

enum PackType {
  SINGLE
  DOUBLE
  TRIPLE
  QUAD
}

enum PhlebotomyOutcome {
  SUCCESSFUL
  UNSUCCESSFUL
}

enum SecurityEventSeverity {
  INFO
  WARNING
  CRITICAL
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  passwordHash            String
  role                    Role
  emailVerified           Boolean                  @default(false)
  isActive                Boolean                  @default(true)
  failedLoginCount        Int                      @default(0)
  lockedUntil             DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  donorProfile            Donor?
  hospitalProfile         Hospital?
  staffProfile            StaffProfile?
  refreshTokens           RefreshToken[]
  sessionLogs             SessionLog[]
  emailVerificationTokens EmailVerificationToken[]
  notifications           Notification[]
  websiteAnnouncementReads WebsiteAnnouncementRead[]
  auditLogs               AuditLog[]               @relation("AuditActor")
  bloodRequestUpdates     BloodRequestUpdate[]     @relation("RequestUpdateActor")
  inventoryUpdates        InventoryItem[]          @relation("InventoryUpdatedBy")
  inventoryLogs           InventoryLog[]           @relation("InventoryLogActor")
  donorResponses          DonorResponse[]
  activityLogs            ActivityLog[]            @relation("ActivityActor")
  securityEvents          SecurityEvent[]          @relation("SecurityActor")
  donorEligibilityReviews DonorEligibilityReview[] @relation("DonorEligibilityReviewer")
  donorClinicalRecords     DonorClinicalRecord[]     @relation("DonorClinicalReviewer")
  donorClinicalAuditTrails DonorClinicalAuditTrail[] @relation("DonorClinicalAuditActor")
  approvedHospitals       Hospital[]               @relation("HospitalApprovedBy")
  rolePermissionOverrides UserPermissionOverride[]

  @@index([role])
  @@index([createdAt])
}

model Donor {
  id                       String          @id @default(cuid())
  userId                   String          @unique
  donorNumber              String?         @unique
  fullName                 String
  phone                    String?
  dateOfBirth              DateTime?
  bloodGroup               BloodGroup
  location                 String
  postalAddress            String?
  signature                String?
  passportPhotoUrl         String?
  dateIssued               DateTime?
  latitude                 Float?
  longitude                Float?
  areaCommunity            String?
  city                     String?
  region                   String?
  lastLocationUpdateAt     DateTime?
  locationSharingEnabled   Boolean         @default(false)
  eligibilityStatus        Boolean         @default(true)
  availabilityStatus       Boolean         @default(true)
  emergencyContactName     String
  emergencyContactPhone    String
  notificationEmailEnabled Boolean         @default(true)
  notificationSmsEnabled   Boolean         @default(false)
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  user                     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  donationHistory          Donation[]
  appointments             Appointment[]
  donorMatches             BloodRequest[]  @relation("MatchedDonors")
  donorResponses           DonorResponse[]
  eligibilityReviews       DonorEligibilityReview[]
  clinicalRecords          DonorClinicalRecord[]

  @@index([bloodGroup])
  @@index([location])
  @@index([city])
  @@index([region])
  @@index([locationSharingEnabled])
  @@index([donorNumber])
  @@index([latitude, longitude])
  @@index([createdAt])
}

model Hospital {
  id               String          @id @default(cuid())
  userId           String          @unique
  hospitalName     String
  registrationCode String          @unique
  address          String
  location         String
  latitude         Float?
  longitude        Float?
  contactName      String
  contactPhone     String
  isApproved       Boolean         @default(true)
  approvedAt       DateTime?
  approvedById     String?
  approvalNotes    String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvedBy       User?           @relation("HospitalApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  bloodRequests    BloodRequest[]
  inventoryItems   InventoryItem[]
  appointments     Appointment[]
  donations        Donation[]
  eligibilityReviews DonorEligibilityReview[]
  donorClinicalRecords DonorClinicalRecord[]
  departments      HospitalDepartment[]
  staffMembers     StaffProfile[]

  @@index([location])
  @@index([isApproved])
  @@index([latitude, longitude])
  @@index([createdAt])
}

model BloodRequest {
  id                     String                @id @default(cuid())
  hospitalId             String
  hospitalCenterName     String?
  ward                   String?
  patientName            String?
  patientCode            String?
  bloodGroup             BloodGroup
  unitsNeeded            Int
  type                   RequestType
  priority               PriorityLevel         @default(MEDIUM)
  status                 RequestStatus         @default(OPEN)
  trackingStatus         RequestProgressStatus @default(PENDING)
  location               String
  emergencyLocation      String?
  city                   String?
  region                 String?
  locationNotes          String?
  latitude               Float?
  longitude              Float?
  notes                  String?
  requestDate            DateTime              @default(now())
  requiredBy             DateTime
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  hospital               Hospital              @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  matchedDonors          Donor[]               @relation("MatchedDonors")
  notificationDispatches Notification[]
  updates                BloodRequestUpdate[]
  donorResponses         DonorResponse[]
  appointments           Appointment[]
  donations              Donation[]

  @@index([status])
  @@index([hospitalId])
  @@index([location])
  @@index([bloodGroup])
  @@index([priority])
  @@index([city])
  @@index([region])
  @@index([latitude, longitude])
  @@index([createdAt])
}

model InventoryItem {
  id             String         @id @default(cuid())
  hospitalId     String
  bloodGroup     BloodGroup
  availableUnits Int
  expiringUnits  Int            @default(0)
  lowThreshold   Int            @default(7)
  criticalThreshold Int         @default(3)
  updatedById    String?
  lastUpdated    DateTime       @updatedAt
  createdAt      DateTime       @default(now())
  hospital       Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  updatedBy      User?          @relation("InventoryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  logs           InventoryLog[]

  @@unique([hospitalId, bloodGroup])
  @@index([hospitalId])
  @@index([bloodGroup])
  @@index([createdAt])
}

model Appointment {
  id             String            @id @default(cuid())
  donorId        String
  hospitalId     String
  bloodRequestId String?
  scheduledAt    DateTime
  status         AppointmentStatus @default(SCHEDULED)
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  donor          Donor             @relation(fields: [donorId], references: [id], onDelete: Cascade)
  hospital       Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  bloodRequest   BloodRequest?     @relation(fields: [bloodRequestId], references: [id], onDelete: SetNull)

  @@index([scheduledAt])
  @@index([donorId])
  @@index([hospitalId])
  @@index([createdAt])
}

model Donation {
  id              String        @id @default(cuid())
  donorId         String
  hospitalId      String?
  bloodRequestId  String?
  bloodGroup      BloodGroup?
  donatedAt       DateTime
  unitsDonated    Int
  location        String
  screeningResult String?
  notes           String?
  createdAt       DateTime      @default(now())
  donor           Donor         @relation(fields: [donorId], references: [id], onDelete: Cascade)
  hospital        Hospital?     @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  bloodRequest    BloodRequest? @relation(fields: [bloodRequestId], references: [id], onDelete: SetNull)

  @@index([donorId])
  @@index([hospitalId])
  @@index([createdAt])
}

model Notification {
  id             String           @id @default(cuid())
  userId         String
  bloodRequestId String?
  type           NotificationType @default(SYSTEM)
  title          String
  body           String
  channel        String
  isRead         Boolean          @default(false)
  delivered      Boolean          @default(false)
  sentAt         DateTime         @default(now())
  createdAt      DateTime         @default(now())
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  bloodRequest   BloodRequest?    @relation(fields: [bloodRequestId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([expiresAt])
  @@index([createdAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  module      String?
  entityType  String
  entityId    String?
  description String?
  ipAddress   String?
  device      String?
  metadata    Json?
  oldValue    Json?
  newValue    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action])
  @@index([module])
  @@index([actorUserId])
}

model BloodRequestUpdate {
  id             String                 @id @default(cuid())
  bloodRequestId String
  updatedById    String?
  oldStatus      RequestProgressStatus?
  newStatus      RequestProgressStatus
  comment        String?
  transfusedByStaffId String?
  unitDin             String?
  patientEncounterId  String?
  overrideReason      String?
  createdAt      DateTime               @default(now())
  bloodRequest   BloodRequest           @relation(fields: [bloodRequestId], references: [id], onDelete: Cascade)
  updatedBy      User?                  @relation("RequestUpdateActor", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([bloodRequestId, createdAt])
  @@index([createdAt])
}

model InventoryLog {
  id            String              @id @default(cuid())
  inventoryId   String
  changeType    InventoryChangeType
  unitsChanged  Int
  previousUnits Int
  newUnits      Int
  reason        String?
  changedById   String?
  createdAt     DateTime            @default(now())
  inventory     InventoryItem       @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  changedBy     User?               @relation("InventoryLogActor", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([inventoryId, createdAt])
  @@index([createdAt])
}

model DonorResponse {
  id             String              @id @default(cuid())
  bloodRequestId String
  donorId        String
  responseStatus DonorResponseStatus @default(PENDING)
  responseTime   DateTime?
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  bloodRequest   BloodRequest        @relation(fields: [bloodRequestId], references: [id], onDelete: Cascade)
  donor          Donor               @relation(fields: [donorId], references: [id], onDelete: Cascade)
  User           User?               @relation(fields: [userId], references: [id])
  userId         String?

  @@unique([bloodRequestId, donorId])
  @@index([bloodRequestId])
  @@index([donorId])
  @@index([responseStatus])
  @@index([createdAt])
}

model DonorEligibilityReview {
  id                  String            @id @default(cuid())
  donorId             String
  selectedHospitalId  String?
  status              DonorReviewStatus @default(SUBMITTED)
  reviewNotes         String?
  officeUseNotes      String?
  clinicalRiskFlag    Boolean           @default(false)
  clinicalRiskNotes   String?
  submittedAt         DateTime          @default(now())
  hospitalReviewedAt  DateTime?
  officeCompletedAt   DateTime?
  approvedAt          DateTime?
  rejectedAt          DateTime?
  reviewerId          String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  donor               Donor             @relation(fields: [donorId], references: [id], onDelete: Cascade)
  selectedHospital    Hospital?         @relation(fields: [selectedHospitalId], references: [id], onDelete: SetNull)
  reviewer            User?             @relation("DonorEligibilityReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([donorId])
  @@index([selectedHospitalId])
  @@index([status])
  @@index([createdAt])
}


model DonorClinicalRecord {
  id                         String              @id @default(cuid())
  donorId                    String
  selectedHospitalId         String?
  reviewerId                 String?
  status                     DonorClinicalStatus @default(DRAFT)
  version                    Int                 @default(1)
  isLocked                   Boolean             @default(false)
  submittedAt                DateTime?
  hospitalReviewedAt         DateTime?
  officeCompletedAt          DateTime?
  finalDecisionAt            DateTime?

  formDate                   DateTime?
  venue                      String?
  title                      String?
  firstName                  String?
  lastName                   String?
  callingName                String?
  dateOfBirth                DateTime?
  sex                        String?
  areaOfResidence            String?
  addressOrWorkplace         String?
  occupation                 String?
  idType                     String?
  idNumber                   String?
  phoneNumber                String?
  email                      String?
  preferredContactMethod     String?
  doNotContactForDonation    Boolean             @default(false)

  donorType                  String?             @default("VOLUNTARY")
  hasDonatedBefore           Boolean?
  lastDonationDate           DateTime?
  numberOfVoluntaryDonations Int                 @default(0)
  numberOfReplacementDonations Int               @default(0)
  donorCardNumber            String?

  patientName                String?
  patientHospital            String?
  ward                       String?
  relationshipToPatient      String?
  clerkingOfficerName        String?
  clerkingOfficerSignature   String?

  declarationConfirmed       Boolean             @default(false)
  testingConsent             Boolean             @default(false)
  contactConsent             Boolean             @default(false)
  staffEligibilityConsent     Boolean             @default(false)
  dataUseConsent             Boolean             @default(false)
  donorSignature             String?
  declarationDate            DateTime?
  counsellorName             String?
  counsellorSignature        String?

  donorRiskFlag              Boolean             @default(false)
  donorRiskSummary           String?
  reviewNotes                String?

  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt

  donor                      Donor               @relation(fields: [donorId], references: [id], onDelete: Cascade)
  selectedHospital           Hospital?           @relation(fields: [selectedHospitalId], references: [id], onDelete: SetNull)
  reviewer                   User?               @relation("DonorClinicalReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  healthAnswers              DonorClinicalHealthAnswer[]
  clinicalReview             DonorClinicalReview?
  donationOutcome            DonorClinicalDonationOutcome?
  versions                   DonorClinicalFormVersion[]
  auditTrails                DonorClinicalAuditTrail[]

  @@index([donorId])
  @@index([selectedHospitalId])
  @@index([status])
  @@index([createdAt])
  @@index([hospitalReviewedAt])
}

model DonorClinicalHealthAnswer {
  id               String              @id @default(cuid())
  clinicalRecordId String
  questionKey      String
  questionText     String
  answer           Boolean
  details          String?
  riskFlag         Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  clinicalRecord   DonorClinicalRecord @relation(fields: [clinicalRecordId], references: [id], onDelete: Cascade)

  @@unique([clinicalRecordId, questionKey])
  @@index([clinicalRecordId])
  @@index([riskFlag])
}

model DonorClinicalReview {
  id                         String                   @id @default(cuid())
  clinicalRecordId           String                   @unique
  appearancePassed           ClinicalPassFail?
  medicalHistoryPassed       ClinicalPassFail?
  weightKg                   Float?
  bloodPressure              String?
  pulseBpm                   Int?
  haemoglobinLevel           Float?
  hbByCuSO4Passed            ClinicalPassFail?
  hbSagChecked               ClinicalYesNo?
  hbSagResult                String?
  qualifiesToDonate          ClinicalYesNo?
  outcomeOfScreening         ClinicalScreeningOutcome?
  permanentDeferralReasons   String[]                 @default([])
  temporaryDeferralReasons   String[]                 @default([])
  temporaryDeferralDuration  String?
  comments                   String?
  nurseName                  String?
  nurseSignature             String?
  reviewedById               String?
  reviewedAt                 DateTime?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  clinicalRecord             DonorClinicalRecord      @relation(fields: [clinicalRecordId], references: [id], onDelete: Cascade)

  @@index([reviewedAt])
}

model DonorClinicalDonationOutcome {
  id                    String              @id @default(cuid())
  clinicalRecordId      String              @unique
  donationNumber        String?
  packType              PackType?
  bleedStartTime        DateTime?
  bleedEndTime          DateTime?
  dryPack               Boolean             @default(false)
  apheresis             Boolean             @default(false)
  testOnly              Boolean             @default(false)
  didNotBleed           Boolean             @default(false)
  outcomeOfPhlebotomy   PhlebotomyOutcome?
  unsuccessfulReason    String?
  venousAccessIssue     Boolean             @default(false)
  underbledMl           Int?
  donorReaction         Boolean             @default(false)
  adverseEvents         String[]            @default([])
  nurseName             String?
  nurseSignature        String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  clinicalRecord        DonorClinicalRecord @relation(fields: [clinicalRecordId], references: [id], onDelete: Cascade)
}

model DonorClinicalFormVersion {
  id               String              @id @default(cuid())
  clinicalRecordId String
  version          Int
  snapshot         Json
  changeReason     String?
  createdById      String?
  createdAt        DateTime            @default(now())
  clinicalRecord   DonorClinicalRecord @relation(fields: [clinicalRecordId], references: [id], onDelete: Cascade)

  @@index([clinicalRecordId, version])
  @@index([createdAt])
}

model DonorClinicalAuditTrail {
  id               String              @id @default(cuid())
  clinicalRecordId String
  actorUserId      String?
  action           String
  description      String?
  oldValue         Json?
  newValue         Json?
  createdAt        DateTime            @default(now())
  clinicalRecord   DonorClinicalRecord @relation(fields: [clinicalRecordId], references: [id], onDelete: Cascade)
  actor            User?               @relation("DonorClinicalAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([clinicalRecordId, createdAt])
  @@index([actorUserId])
  @@index([action])
}

model ActivityLog {
  id             String   @id @default(cuid())
  actorUserId    String?
  actorName      String?
  type           String
  module         String
  title          String
  description    String
  entityType     String?
  entityId       String?
  donorId        String?
  hospitalId     String?
  bloodRequestId String?
  metadata       Json?
  createdAt      DateTime @default(now())
  actor          User?    @relation("ActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([donorId])
  @@index([hospitalId])
  @@index([bloodRequestId])
  @@index([module])
  @@index([type])
  @@index([createdAt])
}

model SecurityEvent {
  id          String                @id @default(cuid())
  actorUserId String?
  email       String?
  eventType   String
  severity    SecurityEventSeverity @default(INFO)
  description String
  ipAddress   String?
  device      String?
  metadata    Json?
  createdAt   DateTime              @default(now())
  actor       User?                 @relation("SecurityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([eventType])
  @@index([severity])
  @@index([createdAt])
}

model HospitalDepartment {
  id           String            @id @default(cuid())
  hospitalId    String
  name          String
  type          DepartmentType
  description   String?
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  hospital      Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  staffMembers  StaffProfile[]

  @@unique([hospitalId, name])
  @@index([hospitalId, type])
  @@index([createdAt])
}

model StaffProfile {
  id               String              @id @default(cuid())
  userId           String              @unique
  hospitalId       String
  departmentId     String?
  employeeCode     String              @unique
  title            String
  status           StaffAccountStatus  @default(ACTIVE)
  isDepartmentHead Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital         Hospital            @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  department       HospitalDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([hospitalId])
  @@index([departmentId])
  @@index([status])
  @@index([createdAt])
}

model RolePermission {
  id         String         @id @default(cuid())
  role       Role
  permission PermissionCode
  isGranted  Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([role, permission])
  @@index([role])
}

model UserPermissionOverride {
  id         String         @id @default(cuid())
  userId      String
  permission  PermissionCode
  isGranted   Boolean
  reason      String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@index([userId])
}

model SessionLog {
  id             String    @id @default(cuid())
  userId         String
  refreshTokenId String?
  ipAddress      String?
  device         String?
  userAgent      String?
  createdAt      DateTime  @default(now())
  lastSeenAt     DateTime?
  expiresAt      DateTime
  loggedOutAt    DateTime?
  isSuspicious   Boolean   @default(false)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@index([isSuspicious, createdAt])
}

model WebsiteAlert {
  id           String        @id @default(cuid())
  title        String
  message      String
  bloodType    BloodGroup?
  hospitalName String
  urgencyLevel PriorityLevel @default(HIGH)
  isActive     Boolean       @default(false)
  isSticky     Boolean       @default(true)
  isScrolling  Boolean       @default(false)
  expiresAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([isActive, expiresAt])
  @@index([createdAt])
}

model WebsiteStatistic {
  id                String              @id @default(cuid())
  key               WebsiteStatisticKey @unique
  label             String
  description       String
  overrideValue     Int?
  isOverrideEnabled Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model Faq {
  id          String   @id @default(cuid())
  question    String
  answer      String
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished])
  @@index([createdAt])
}

model Testimonial {
  id          String   @id @default(cuid())
  name        String
  role        String
  message     String
  location    String
  isApproved  Boolean  @default(false)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isApproved, isPublished])
  @@index([createdAt])
}

model AwarenessPost {
  id          String   @id @default(cuid())
  title       String
  content     String
  image       String?
  category    String
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished])
  @@index([category])
  @@index([createdAt])
}

model PartnerHospital {
  id           String   @id @default(cuid())
  hospitalName String
  location     String
  phone        String
  email        String
  description  String
  latitude     Float?
  longitude    Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([hospitalName])
  @@index([location])
  @@index([createdAt])
}

model WebsiteFooterSettings {
  id               String   @id @default(cuid())
  singletonKey     String   @unique @default("default")
  emergencyPhonePrimary   String
  emergencyPhoneSecondary String?
  supportEmail     String
  facebookUrl      String?
  instagramUrl     String?
  linkedinUrl      String?
  footerText       String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model WebsiteAnnouncement {
  id         String                   @id @default(cuid())
  sourceKey  String                   @unique
  sourceType WebsiteAnnouncementType
  title      String
  message    String
  href       String
  priority   PriorityLevel            @default(MEDIUM)
  badge      String?
  isPublished Boolean                 @default(true)
  expiresAt  DateTime?
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt
  reads      WebsiteAnnouncementRead[]

  @@index([sourceType, isPublished])
  @@index([expiresAt])
  @@index([createdAt])
}

model WebsiteAnnouncementRead {
  id             String              @id @default(cuid())
  announcementId String
  userId         String
  readAt         DateTime            @default(now())
  announcement   WebsiteAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId, readAt])
}
